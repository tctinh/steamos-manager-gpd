post_install() {
  echo ":: Loading acpi_call module..."
  modprobe acpi_call 2>/dev/null || true

  echo ":: Enabling steamos-manager-acpi-call.service..."
  systemctl daemon-reload
  systemctl enable --now steamos-manager-acpi-call.service 2>/dev/null || true

  echo ":: Restarting steamos-manager user service..."
  if [ -n "$SUDO_USER" ]; then
    su - "$SUDO_USER" -c "systemctl --user restart steamos-manager.service" 2>/dev/null || true
  fi

  echo ""
  echo "==> NOTE: If TDP control does not appear, try rebooting."
  echo "==> The acpi_call kernel module must be loaded and"
  echo "==> steamos-manager-acpi-call.service must be running."
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now steamos-manager-acpi-call.service 2>/dev/null || true
}
